# 可复制到当前项目的 .env，或复制到 ~/.config/kd1-anime/.env。
# 系统环境变量 > 当前目录 .env > 用户级 ~/.config/kd1-anime/.env。

# --- LLM API（任意 OpenAI 兼容端点）---
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your-model-name
LLM_SEND_MAX_TOKENS=true
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=2.0
LLM_PARALLEL_WORKERS=4
LLM_DEBUG=false

# --- Slurm ---
SLURM_PARTITION=
SLURM_QOS=
SLURM_ACCOUNT=
SLURM_CONDA_ENV=manim_env
# 留空时，作业脚本会通过 conda info --base 动态探测。
SLURM_CONDA_BASE=
SLURM_TIME_LIMIT=01:00:00
SLURM_CPUS_PER_TASK=4
SLURM_MEM_GB=
SLURM_GPU_TYPE=
SLURM_GPU_COUNT=1
# 0=全部场景均可在途；正整数限制同时排队/运行的场景作业数。
SLURM_MAX_IN_FLIGHT=0
SLURM_SUBMIT_RETRIES=3
SLURM_SUBMIT_RETRY_DELAY=2.0
# 推荐配置 Apptainer 镜像来隔离 LLM 生成代码。
SLURM_CONTAINER_IMAGE=
SLURM_REQUIRE_CONTAINER=false

# --- Manim ---
MANIM_RENDERER=cairo
MANIM_QUALITY=h
MANIM_PIXEL_WIDTH=1920
MANIM_PIXEL_HEIGHT=1080
MANIM_FRAME_RATE=60
MANIM_OPENGL_PLATFORM=egl
ALLOW_PARTIAL_OUTPUT=false
OVERWRITE_OUTPUT=false

# --- 流水线 ---
MAX_REVIEW_ROUNDS=3
MAX_FIX_ATTEMPTS=3
MAX_CLARIFY_ROUNDS=6
MAX_SCENES=12
MAX_PROMPT_CHARS=50000
MAX_LOG_CHARS=30000
CODE_VALIDATION_ATTEMPTS=3
MONITOR_POLL_INTERVAL=10
MONITOR_QUEUE_TIMEOUT=3600
MONITOR_RUN_TIMEOUT=3600
MONITOR_MAX_UNKNOWN=5
LOG_TAIL_LINES=80

WORKSPACE_DIR=workspace
OUTPUT_FILE=output_final.mp4
