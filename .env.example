# 可复制到当前项目的 .env，或复制到 ~/.config/kd1-anime/.env。
# 系统环境变量 > 当前目录 .env > 用户级 ~/.config/kd1-anime/.env。
# 所有值与 src/kd1_anime/config.py 的默认值保持一致。

# --- LLM API（任意 OpenAI 兼容端点）---
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your-model-name
LLM_SEND_MAX_TOKENS=true
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=32768
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=2.0
LLM_PARALLEL_WORKERS=4
LLM_DEBUG=false
LLM_USE_JSON_MODE=true
# 连接/读取超时(秒)。读取超时对非流式是"等待完整响应"，对(静默)流式是"等待下一个 chunk"。
LLM_TIMEOUT_CONNECT=30.0
LLM_TIMEOUT_READ=600.0
# stream=False 时仍走流式传输但静默收集，避免推理模型长生成触发超时→重头生成
LLM_SILENT_STREAM=true
# 空响应重试时补上的 max_tokens 兜底值（推理模型常把输出预算耗尽在思考上）
LLM_EMPTY_RETRY_MAX_TOKENS=16384
# 结构化 JSON 输出未通过 Pydantic 校验时, 带错误反馈重试的次数 (0=关闭)
LLM_JSON_REPAIR_ATTEMPTS=2

# --- Slurm ---
SLURM_PARTITION=
SLURM_QOS=
SLURM_ACCOUNT=
SLURM_CONDA_ENV=manim_env
# 留空时，作业脚本会通过 conda info --base 动态探测。
SLURM_CONDA_BASE=
SLURM_TIME_LIMIT=01:00:00
SLURM_CPUS_PER_TASK=4
SLURM_MEM_GB=
SLURM_GPU_TYPE=
SLURM_GPU_COUNT=1
# 0=全部场景均可在途；正整数限制同时排队/运行的场景作业数。
SLURM_MAX_IN_FLIGHT=0
SLURM_SUBMIT_RETRIES=3
SLURM_SUBMIT_RETRY_DELAY=2.0
# 推荐配置 Apptainer 镜像来隔离 LLM 生成代码。
SLURM_CONTAINER_IMAGE=
SLURM_REQUIRE_CONTAINER=false
# 目标集群支持无特权网络命名空间时可设 true；启用前请先测试 Apptainer --net。
SLURM_CONTAINER_DISABLE_NETWORK=false

# --- Manim ---
MANIM_RENDERER=cairo
MANIM_QUALITY=h
MANIM_PIXEL_WIDTH=1920
MANIM_PIXEL_HEIGHT=1080
MANIM_FRAME_RATE=60
MANIM_OPENGL_PLATFORM=egl
ALLOW_PARTIAL_OUTPUT=false
OVERWRITE_OUTPUT=false

# --- 流水线 ---
MAX_REVIEW_ROUNDS=5
SKIP_REVIEW=false
MAX_FIX_ATTEMPTS=5
# 节点故障/抢占等基础设施终态的自动重新排队次数。
MAX_INFRA_RETRIES=2
# 连续 N 次渲染错误日志指纹相同 → 判定为环境/配置问题提前放弃。
# 注意该检查在代码中还会叠加 fix_attempts>=2 门槛，确保修复器至少有 2 次真实尝试。
MAX_FIX_IDENTICAL_ERRORS=3
MAX_CLARIFY_ROUNDS=12
MAX_SCENES=12
MAX_PROMPT_CHARS=50000
# 澄清对话发送给模型的最大字符数；超出时保留初始需求和最近回答。
MAX_CLARIFY_CONTEXT_CHARS=40000
MAX_LOG_CHARS=30000
CODE_VALIDATION_ATTEMPTS=3
MONITOR_POLL_INTERVAL=10
MONITOR_QUEUE_TIMEOUT=3600
MONITOR_RUN_TIMEOUT=3600
MONITOR_MAX_UNKNOWN=5
# UNKNOWN 至少持续该时间且达到上面的连续次数后才取消远端作业。
MONITOR_UNKNOWN_TIMEOUT=300
# Slurm 报告完成后等待共享文件系统同步最终 MP4 的秒数。
MONITOR_ARTIFACT_GRACE=60
LOG_TAIL_LINES=80

# --- 自动评估（默认关闭；需要时开启） ---
ENABLE_AUTO_EVAL=false
ENABLE_VISUAL_EVAL=false
EVAL_THRESHOLD=3.5
MAX_EVAL_ROUNDS=2
# 视觉评估使用的模型（默认使用 LLM_MODEL）
# EVAL_VISUAL_MODEL=

WORKSPACE_DIR=workspace
OUTPUT_FILE=output_final.mp4
# 覆盖默认的目录布局（一般无需设置，默认派生自 WORKSPACE_DIR）
# SCENES_DIR=workspace/scenes
# LOGS_DIR=workspace/logs
# VIDEOS_DIR=workspace/videos
