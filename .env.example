# ============================================================
# kd1-anime 配置文件
# 复制本文件为 .env 并填入实际值: cp .env.example .env
# ============================================================

# --- LLM API (兼容任意 OpenAI 接口的服务) ---
# 填入你使用的 LLM 服务的 API Key (真实 Key 请只放 .env, 不要放本文件)
LLM_API_KEY=sk-your-key-here

# API 地址 (去掉末尾的 /v1 或 /chat/completions, 只保留基地址)
LLM_BASE_URL=https://llmproxy.cmet.ustc.edu.cn/v1

# 模型名称
LLM_MODEL=glm-5.2

# 部分 (推理类) 模型拒绝 max_tokens, 设为 False 则不发送该参数
LLM_SEND_MAX_TOKENS=true

# --- Slurm 集群 ---
SLURM_PARTITION=Students
SLURM_QOS=qos_stu_default
SLURM_CONDA_ENV=manim_env
SLURM_TIME_LIMIT=01:00:00
SLURM_CPUS_PER_TASK=4
#SLURM_MEM_GB=8
#SLURM_GPU_TYPE=A100
#SLURM_GPU_COUNT=1

# --- Agent 参数 ---
MAX_REVIEW_ROUNDS=3
MAX_FIX_ATTEMPTS=3
MAX_CLARIFY_ROUNDS=6
MONITOR_POLL_INTERVAL=10
MONITOR_TIMEOUT=3600
MONITOR_MAX_UNKNOWN=5
LOG_TAIL_LINES=80

# --- LLM 调优 ---
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=2.0
