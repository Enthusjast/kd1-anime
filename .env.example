# When ~/.kd1-anime/config.toml exists it takes precedence over dotenv files.
# Keep personal .env/config.toml files private (chmod 600).
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_MODEL=your-model-name
# Total logical-call duration includes quota waiting, retries and response.
# 0 keeps the existing per-request transport timeouts without a total deadline.
LLM_TIMEOUT_TOTAL=0

GENERATION_MODE=relaxed
MAX_SCENE_LLM_REQUESTS=64
MAX_RUN_LLM_REQUESTS=512
SCENE_CODEGEN_MODE=llm
CODE_VALIDATION_ATTEMPTS=3
MAX_PLAN_REVIEW_ROUNDS=2
MAX_PLAN_REPLAN_ATTEMPTS=3
MAX_REVIEW_ROUNDS=8
MAX_FIX_ATTEMPTS=8
MAX_CONTINUITY_FIX_ROUNDS=2
ALLOW_PARTIAL_OUTPUT=false

RENDER_BACKEND=slurm
MANIM_RENDERER=cairo
# OpenGL requires a configured Slurm GPU type.
# SLURM_GPU_TYPE=your-gpu-type
# Use the same container policy for Slurm, local rendering, and smoke checks.
SLURM_REQUIRE_CONTAINER=false
# SLURM_CONTAINER_IMAGE=/absolute/path/to/render.sif

# The optional visual model uses its own credentials and endpoint.
ENABLE_VISUAL_EVAL=false
VISUAL_LLM_API_KEY=
VISUAL_LLM_BASE_URL=
VISUAL_LLM_TIMEOUT_TOTAL=0
VISUAL_LLM_MODEL=
RAG_ENABLED=false
