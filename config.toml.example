# kd1-anime 运行时配置模板
# 复制到 ~/.kd1-anime/config.toml 后编辑；文件可能包含 API Key，权限应为 0600。
# 优先级：进程环境变量 > 此文件 > 当前目录 .env > ~/.kd1-anime/.env

[llm]
api_key = "sk-your-key-here"
base_url = "https://api.openai.com/v1"
model = "your-model-name"
planning_model = ""
technical_model = ""
code_model = ""
review_model = ""
fix_model = ""
send_max_tokens = true
temperature = 0.3
planning_temperature = 0.2
technical_temperature = 0.0
code_temperature = 0.2
review_temperature = 0.0
fix_temperature = 0.1
max_tokens = 32768
planning_max_tokens = 16384
technical_max_tokens = 16384
code_max_tokens = 24576
review_max_tokens = 8192
max_retries = 3
retry_base_delay = 2.0
timeout_connect = 30.0
timeout_read = 600.0
healthcheck_timeout = 15.0
silent_stream = true
empty_retry_max_tokens = 16384
json_repair_attempts = 2
parallel_workers = 4
debug = false
trust_env = true
use_json_mode = true
max_context_chars = 120000
max_code_context_chars = 60000
max_review_context_chars = 90000
max_technical_spec_chars = 30000

[visual_llm]
api_key = ""
base_url = ""
model = ""
send_max_tokens = true
temperature = 0.0
max_tokens = 3000
max_retries = 3
retry_base_delay = 2.0
timeout_connect = 30.0
timeout_read = 300.0
healthcheck_timeout = 20.0
json_repair_attempts = 1
use_json_mode = true
parallel_workers = 2
debug = false
trust_env = true

[rag]
enabled = false
index_path = "~/.kd1-anime/rag/index.sqlite3"
docs_dir = "~/.kd1-anime/knowledge/docs"
examples_dir = "~/.kd1-anime/knowledge/examples"
recipes_dir = "~/.kd1-anime/knowledge/recipes"
embedding_api_key = ""
embedding_base_url = ""
embedding_model = ""
embedding_timeout = 60.0
embedding_batch_size = 32
rerank_api_key = ""
rerank_base_url = ""
rerank_model = ""
rerank_timeout = 60.0
trust_env = true
top_k = 8
rerank_top_n = 4
max_context_chars = 12000
chunk_size = 1800
chunk_overlap = 200
parallel_workers = 2

[render]
backend = "slurm"
local_render_max_in_flight = 1
local_render_timeout = 3600
local_render_memory_mb = 16384
manim_renderer = "cairo"
manim_quality = "h"
manim_pixel_width = 1920
manim_pixel_height = 1080
manim_frame_rate = 60
manim_opengl_platform = "egl"
smoke_render_enabled = true
smoke_render_mode = "both"
smoke_render_quality = "l"
smoke_render_timeout = 180
smoke_render_short_animations = 3
local_smoke_render_enabled = false
local_smoke_render_mode = "frame"
local_smoke_render_quality = "l"
local_smoke_render_timeout = 180
local_smoke_render_short_animations = 3
local_smoke_render_memory_mb = 4096
allow_partial_output = false
overwrite_output = false

[slurm]
partition = ""
account = ""
qos = ""
conda_env = "manim_env"
conda_base = ""
time_limit = "01:00:00"
cpus_per_task = 4
mem_gb = ""
gpu_type = ""
gpu_count = 1
max_in_flight = 0
submit_retries = 3
submit_retry_delay = 2.0
container_image = ""
require_container = false
container_disable_network = false

[merge]
transition_type = "fade"
transition_duration = 0.5
merge_video_codec = "libx264"
merge_video_preset = "medium"
merge_video_crf = 18
merge_audio_sample_rate = 48000
merge_audio_channel_layout = "stereo"

[paths]
workspace_dir = "~/.kd1-anime/workspace"
output_file = "output_final.mp4"
scenes_dir = "~/.kd1-anime/workspace/scenes"
logs_dir = "~/.kd1-anime/workspace/logs"
videos_dir = "~/.kd1-anime/workspace/videos"

[pipeline]
failure_cases_path = "~/.kd1-anime/diagnostics/failure_cases.sqlite3"
max_technical_spec_attempts = 3
codegen_mode = "python"
auto_resource_estimation = true
adaptive_smoke_render = true
max_review_rounds = 8
max_low_risk_review_rounds = 2
max_plan_review_rounds = 2
max_plan_replan_attempts = 3
max_continuity_fix_rounds = 2
continuity_context_mode = "minimal"
skip_review = false
safe_fallback_enabled = true
max_identical_review_attempts = 2
max_stagnant_attempts = 2
max_fix_attempts = 8
max_infra_retries = 2
max_fix_identical_errors = 3
max_clarify_rounds = 12
max_scenes = 12
max_prompt_chars = 50000
max_clarify_context_chars = 40000
max_log_chars = 30000
failure_case_max_per_category = 100
code_validation_attempts = 3
max_code_candidates_low = 1
max_code_candidates_medium = 2
max_code_candidates_high = 3

[evaluation]
enable_auto_eval = false
enable_visual_eval = false
eval_threshold = 3.5
max_eval_rounds = 2
eval_visual_model = ""
visual_eval_frame_count = 6
visual_eval_threshold = 3.5
max_visual_fix_attempts = 2

[monitor]
monitor_poll_interval = 10
monitor_queue_timeout = 3600
monitor_run_timeout = 3600
monitor_max_unknown = 5
monitor_unknown_timeout = 300
monitor_artifact_grace = 60
log_tail_lines = 80
